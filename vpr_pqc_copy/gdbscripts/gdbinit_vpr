define csr_write
   set *(uint32_t *)$VPR_DEBUGIF_DATA0 = $arg1
   set *(uint32_t *)$VPR_DEBUGIF_ABSTRACTCMD = (0 << 24) | (2 << 20) | (1 << 17) | (1 << 16) | ($arg0 & 0xFFF)
   set $end_loop = 0
   while ($end_loop != 0) 
        set $abstractcs = *((uint32_t *)$VPR_DEBUG_ABSTRACTCS) & (1 << 12)
        if ($abstractcs == 0)
            set $end_loop = 1
        end
   end
end

define csr_read
   set *(uint32_t *)$VPR_DEBUGIF_ABSTRACTCMD = (0 << 24) | (2 << 20) | (1 << 17) | (0 << 16) | (0xC00 & 0xFFF)
   set $end_loop = 0
   while ($end_loop != 0) 
        set $abstractcs = *((uint32_t *)$VPR_DEBUGIF_ABSTRACTCS) & (1 << 12)
        if ($abstractcs == 0)
            set $end_loop = 1
        end
   end
   set $res = *(uint32_t *)$VPR_DEBUGIF_DATA0
   set *(uint32_t *)$VPR_DEBUGIF_ABSTRACTCMD = (0 << 24) | (2 << 20) | (1 << 17) | (0 << 16) | ($arg0 & 0xFFF)
   set $end_loop = 0
   while ($end_loop != 0) 
        set $abstractcs = *((uint32_t *)$VPR_DEBUG_ABSTRACTCS) & (1 << 12)
        if ($abstractcs == 0)
            set $end_loop = 1
        end
   end
   set $res = *(uint32_t *)$VPR_DEBUGIF_DATA0
   p/x $res
end

define write_csr
    csr_write $arg0 $arg1
end

define read_csr
    csr_read $arg0
end

define csr
    if $argc == 1
        read_csr $arg0
    else
        write_csr $arg0 $arg1
    end
end

