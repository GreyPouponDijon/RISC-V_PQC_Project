    csr_write $CSR_NORDIC_VPRNORDICCTRL $nordic_ctrl_new
end

define print_jobs
    set $i = 0
    printf "num_of_jobs: %u\n", $arg0->num_of_jobs
    printf "current_job: %u\n", $arg0->current_job
    printf "last_job: %u\n", $arg0->last_job
    while $i < $arg0->num_of_jobs
        set $job = $arg0->jobs[$i]
        if ($job.id == 0)
            printf "conf: pending: %u, spiframeformat: %u, frequency: %u\n", $job.pending, $job.payload.conf.spiframeformat, $job.payload.conf.frequency
        end
        if ($job.id == 1)
            printf "trans: pending %u, addr: 0x%.8lx, addrlen %u, transtype: %u, transmode: %u, txdata_len: %u\n", $job.pending, $job.payload.trans.address, $job.payload.trans.address_len, $job.payload.trans.transtype, $job.payload.trans.transmode, $job.payload.trans.tx_data_len
        end
        set $i = $i + 1
    end
end

